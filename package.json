{
  "name": "gvdg-club-site-static",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build:home && npm run build:public && npm run build:admin && npm run build:tee-sign-preview && npm run build:score && npm run build:members",
    "build:admin": "vite build --config vite.admin.config.mjs",
    "build:home": "vite build --config vite.home.config.mjs",
    "build:members": "vite build --config vite.members.config.mjs",
    "build:public": "vite build --config vite.public.config.mjs",
    "build:score": "vite build --config vite.score.config.mjs",
    "build:tee-sign-preview": "vite build --config vite.tee-sign-preview.config.mjs",
    "doctor": "react-doctor --no-dead-code --no-score --blocking none",
    "qa:ensure-staging-dashboard-data": "node scripts/qa/ensure-staging-dashboard-data.mjs",
    "qa:live-scoring": "npm run build:score && node scripts/qa/live-scoring-browser-qa.mjs",
    "qa:members-dashboard": "npm run build:members && node scripts/qa/members-dashboard-browser-qa.mjs",
    "qa:react": "npm run doctor",
    "qa:site-smoke": "npm run build && npm run qa:site-smoke:run",
    "qa:site-smoke:run": "node scripts/qa/site-smoke-browser-qa.mjs",
    "qa:staging-member-dashboard": "node scripts/qa/staging-member-dashboard-e2e.mjs",
    "qa:staging-live-scoring": "node scripts/qa/staging-live-scoring-e2e.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "playwright": "^1.61.1",
    "react-doctor": "^0.7.1",
    "react-grab": "^0.1.48",
    "react-scan": "^0.5.7",
    "vite": "^8.1.3"
  },
  "dependencies": {
    "lucide-react": "^1.23.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  }
}
